<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!--
    RoboDojo autonomous navigation tree (Nav2 / BehaviorTree.CPP v4).

    Loaded by nav2_bt_navigator as the default NavigateToPose tree. It drives
    Nav2's planning + control pipeline and layers RoboDojo safety on top:

      ComputePathToPose  ->  FollowPath (with replanning at 1 Hz)
        * Collision gate: while the mission node reports an obstacle inside the
          emergency stop radius, publish zero velocity on /cmd_vel_emergency and
          do not command the controller. When the path ahead is clear the gate is
          transparent.
      Recovery (runs only when a goal step fails)
        * stuck  (mission node "is_stuck")  -> back up + spin
        * collision imminent                -> back up + wait
        * otherwise                         -> clear costmaps / spin / wait

    The mission "brain" (EXPLORE / NAV_TO_GOAL / WAYPOINT_RUN / DOCK, frontier
    selection, goal sequencing, /cmd_vel_emergency manoeuvres) lives in
    autonomous_mission_node. That node drives this tree through the standard
    NavigateToPose / NavigateThroughPoses actions, so the tree only has to reach
    the goal placed on the {goal} blackboard by the navigator.

    Custom node IDs provided by dojo_bt_plugins:
      IsCollisionImminent, EmergencyStop, MissionStuck
    (MissionStuck is deliberately not named "IsStuck": Nav2 already registers an
     IsStuck condition and BehaviorTree.CPP throws on duplicate IDs.)
  -->

  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateToPoseRecovery">
      <PipelineSequence name="NavigateWithReplanning">

        <!-- Replan the global path at 1 Hz while following it. -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!-- Follow the path, guarded by the collision gate. -->
        <RecoveryNode number_of_retries="1" name="CollisionSafeFollowPath">
          <Sequence name="GuardedFollowPath">
            <!-- Side-effect gate: emit an emergency stop if a collision is
                 imminent. AlwaysSuccess keeps this branch transparent when the
                 path ahead is clear. -->
            <Fallback name="EmergencyStopGate">
              <Sequence name="StopOnImminentCollision">
                <IsCollisionImminent/>
                <EmergencyStop/>
              </Sequence>
              <AlwaysSuccess/>
            </Fallback>
            <!-- Only hand control to the controller when the path is clear.
                 Fails the step otherwise, which triggers recovery. -->
            <Inverter name="ProceedOnlyWhenClear">
              <IsCollisionImminent/>
            </Inverter>
            <FollowPath path="{path}"
                        controller_id="FollowPath"
                        goal_checker_id="general_goal_checker"/>
          </Sequence>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <!-- Recovery: pick a strategy based on why we lost the goal. The generic
           RoundRobin always eventually succeeds so the outer retry loop keeps
           replanning instead of aborting the goal. -->
      <Fallback name="RecoveryStrategy">
        <Sequence name="StuckRecovery">
          <MissionStuck/>
          <BackUp backup_dist="0.15" backup_speed="0.15"/>
          <Spin spin_dist="1.57"/>
        </Sequence>
        <Sequence name="CollisionRecovery">
          <IsCollisionImminent/>
          <BackUp backup_dist="0.20" backup_speed="0.15"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
        <RoundRobin name="GenericRecovery">
          <ClearEntireCostmap name="ClearLocalCostmap-Recovery"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Recovery"
                              service_name="global_costmap/clear_entirely_global_costmap"/>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="1.0"/>
        </RoundRobin>
      </Fallback>

    </RecoveryNode>
  </BehaviorTree>
</root>
