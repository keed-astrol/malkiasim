<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="floor_collision">
        <max_contacts>1400</max_contacts>
        <geometry>
          <mesh>
            <uri>model://gamefield_arena/meshes/gamefield_floor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
         <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <!-- Adds wheel grip friction -->
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="walls_collision">
        <max_contacts>1400</max_contacts>
        <geometry>
          <mesh>
            <uri>model://gamefield_arena/meshes/gamefield_walls.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="floor_visual">
        <geometry>
          <mesh>
            <uri>model://gamefield_arena/meshes/gamefield_floor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="walls_visual">
        <geometry>
          <mesh>
            <uri>model://gamefield_arena/meshes/gamefield_walls.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.53 0.81 0.98 1</ambient>
          <diffuse>0.53 0.81 0.98 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
