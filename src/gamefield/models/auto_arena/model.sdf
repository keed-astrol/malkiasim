<?xml version="1.0"?>
<sdf version="1.9">
  <model name="auto_arena">
    <static>true</static>

    <!-- ========== FLOOR + WALLS ========== -->
    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <collision name="floor_collision">
        <max_contacts>1400</max_contacts>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/gamefield_floor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <collision name="walls_collision">
        <max_contacts>1400</max_contacts>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/gamefield_walls.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="floor_visual">
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/gamefield_floor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="walls_visual">
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/gamefield_walls.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.53 0.81 0.98 1</ambient>
          <diffuse>0.53 0.81 0.98 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- ========== OBSTACLES ========== -->
    <link name="obstacles">
      <!-- Cylinder 1 -->
      <collision name="cylinder_1_collision">
        <pose>1.074426 1.218207 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="cylinder_1_visual">
        <pose>1.074426 1.218207 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.1 1</ambient>
          <diffuse>0.8 0.2 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Cylinder 2 -->
      <collision name="cylinder_2_collision">
        <pose>2.080075 0.678606 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="cylinder_2_visual">
        <pose>2.080075 0.678606 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.1 1</ambient>
          <diffuse>0.8 0.2 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Cylinder 3 -->
      <collision name="cylinder_3_collision">
        <pose>1.085832 0.118266 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="cylinder_3_visual">
        <pose>1.085832 0.118266 0.000523 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cylinder.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.1 1</ambient>
          <diffuse>0.8 0.2 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Cross structure -->
      <collision name="cross_structure_collision">
        <pose>1.555971 -1.146427 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cross_structure.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="cross_structure_visual">
        <pose>1.555971 -1.146427 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://auto_arena/meshes/cross_structure.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.1 1</ambient>
          <diffuse>0.9 0.7 0.1 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>