Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: World Grid
      Plane: XY
      Plane Cell Count: 100
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 160; 160; 160
      Alpha: 0.65
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Name: World Axes
      Length: 2
      Radius: 0.05
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PublishPoint
      Enabled: true
      Name: Clicked Point
      Single click: true
      Topic: /clicked_point
      Value: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 35
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 100
  Y: 80
  Views:
    collapsed: false
